.venv/
__pycache__/
*.pyc
.env
# data/ بكامله غير مُتتبَّع إلا ملف مقياس كلمات اليد المطلوب وقت التشغيل
data/*
!data/asl_signs/
data/asl_signs/*
!data/asl_signs/words_en_scaler.json
# نعمّل ملفات الاستدلال فقط (قصيرة الحجم) ولا نتتبع النسخ الاحتياطية ولا نقاط الاستئناف
models/*
!models/cnn.pt
!models/cnn_en.pt
!models/words_en.keras
!models/class_map.json
!models/class_map_en.json
!models/words_en_classes.json
# assets/* كاملة مطلوبة وقت التشغيل (hand_landmarker.task + صور القاموس) فتُتتبع ولا تُتجاهل
logs/
*.log
.pytest_cache/
debug/
debug_crops/
train_ar.err
train_en.err